    "taskOutput": {
      "type": "object",
      "properties": {
        "type": {
          "const": "taskOutput"
        },
        "execution": {
          "$ref": "#/$defs/text"
        },
        "task": {
          "$ref": "#/$defs/text"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "value": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "type",
        "execution",
        "task",
        "index",
        "value"
      ],
      "additionalProperties": false
    },
    "taskOutputFailed": {
      "type": "object",
      "properties": {
        "type": {
          "const": "taskOutputFailed"
        },
        "execution": {
          "$ref": "#/$defs/text"
        },
        "task": {
          "$ref": "#/$defs/text"
        },
        "index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
