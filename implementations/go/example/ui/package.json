{
  "name": "@suimon/go-example-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "build:wasm": "bash ../../../../bin/build-playground-wasm && pnpm typecheck && vite build --mode wasm",
    "test:wasm": "node --test tests/wasm.smoke.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "@suimon/ui-kit": "workspace:*",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.1",
    "vitest": "^4.0.0"
  }
}
