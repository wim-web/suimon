{
  "name": "@suimon/go-example-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "build:wasm": "bash ../../../../bin/build-playground-wasm && pnpm typecheck && vite build --mode wasm",
    "test:wasm": "node --test tests/wasm.smoke.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@suimon/ui-kit": "workspace:*",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1"
  }
}
