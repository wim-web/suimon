#!/usr/bin/env bash
# schema also runs a pinned Python JSON Schema oracle in .lake/schema-venv.
# PYTHON selects the Python 3 interpreter used to create that isolated environment.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
suite="${1:-all}"
if [[ $# -gt 1 || ! "$suite" =~ ^(all|lean|schema)$ ]]; then
  echo 'Usage: bin/test [all|lean|schema]' >&2
  exit 2
fi
if [[ -n "${LAKE:-}" ]]; then
  lake_bin="$LAKE"
elif command -v lake >/dev/null 2>&1; then
  lake_bin="$(command -v lake)"
else
  lake_bin="$HOME/.elan/bin/lake"
fi
if ! command -v rg >/dev/null 2>&1; then
  echo 'bin/test needs rg (ripgrep) to find unfinished proofs.' >&2
  exit 1
fi
if rg -n '\b(sorry|admit|axiom|native_decide|implemented_by)\b' Suimon Test Main.lean Suimon.lean lakefile.lean --glob '*.lean'; then
  echo 'Unfinished proofs or unchecked axioms found.' >&2
  exit 1
else
  scan_status=$?
  if [[ "$scan_status" -ne 1 ]]; then
    printf 'Proof scan failed (rg exit status %s).\n' "$scan_status" >&2
    exit "$scan_status"
  fi
fi
if [[ "$suite" != schema ]]; then
  "$lake_bin" build Suimon suimon suimon_test
  .lake/build/bin/suimon_test
fi
if [[ "$suite" != lean ]]; then
  "$lake_bin" build suimon_schema_test
  .lake/build/bin/suimon_schema_test
  # Keep the independent oracle isolated from the user's Python installation.
  if [[ ! -x .lake/schema-venv/bin/python ]]; then
    "${PYTHON:-python3}" -m venv .lake/schema-venv
  fi
  .lake/schema-venv/bin/python -m pip install --disable-pip-version-check --no-cache-dir --quiet -r Test/schema-requirements.txt
  .lake/schema-venv/bin/python Test/schema_oracle.py
fi
