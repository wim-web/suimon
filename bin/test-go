#!/usr/bin/env bash
# Tests the Go implementation in implementations/go.
#   unit         Go tests (the runtime scenarios and crash recovery included), the race detector
#                on the package, and go vet.
#   conformance  Compares the Go CLI with the Lean CLI at SUIMON_LEAN_CLI (default
#                .lake/build/bin/suimon), and has it check the journals the runtime writes; it
#                builds nothing, so build the Lean CLI first (lake build suimon).
#   all          Both (the default).
# GO overrides the go command.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
suite="${1:-all}"
if [[ $# -gt 1 || ! "$suite" =~ ^(all|unit|conformance)$ ]]; then
  echo 'Usage: bin/test-go [all|unit|conformance]' >&2
  exit 2
fi
go_bin="${GO:-go}"
if ! "$go_bin" version >/dev/null 2>&1; then
  echo "bin/test-go: '$go_bin version' failed; set GO to a Go toolchain (go.mod: $(awk '$1 == "go" {print $2}' implementations/go/go.mod) or later)" >&2
  exit 1
fi
packages=(./src/... ./cmd/... ./example/...)

unit() {
  (
    unset SUIMON_LEAN_CLI
    cd implementations/go
    "$go_bin" test -count=1 "${packages[@]}"
    "$go_bin" test -race -count=1 ./src
    "$go_bin" vet "${packages[@]}"
  )
}

conformance() {
  local lean_cli="${SUIMON_LEAN_CLI:-.lake/build/bin/suimon}"
  if [[ "$lean_cli" != /* ]]; then
    lean_cli="$repo_root/$lean_cli"
  fi
  if [[ ! -x "$lean_cli" ]]; then
    echo "bin/test-go: no Lean CLI at $lean_cli (build it with lake build suimon, or set SUIMON_LEAN_CLI)" >&2
    exit 1
  fi
  (
    cd implementations/go
    SUIMON_LEAN_CLI="$lean_cli" "$go_bin" test -count=1 -v -run '^TestConformance' "${packages[@]}"
  )
}

case "$suite" in
  unit) unit ;;
  conformance) conformance ;;
  all)
    unit
    conformance
    ;;
esac
