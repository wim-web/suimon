{
  "main": "dashboard",
  "functions": [
    {"id": "fetchSales", "output": {"single": "Sales"}},
    {"id": "fetchStock", "output": {"single": "Stock"}},
    {"id": "render", "input": {"list": "Widget"}, "output": {"single": "Page"}},
    {"id": "archive", "input": "Sales", "output": {"single": "Archived"}},
    {"id": "notifyDone", "output": {"single": "Ack"}}
  ],
  "transforms": [
    {"id": "sales", "input": "Sales", "output": "Sales"},
    {"id": "salesWidget", "input": "Sales", "output": "Widget"},
    {"id": "stockWidget", "input": "Stock", "output": "Widget"},
    {"id": "widgets", "input": {"list": "Widget"}, "output": {"list": "Widget"}}
  ],
  "workflows": [
    {
      "id": "dashboard",
      "placements": [
        {"name": "sales", "node": {"type": "function", "function": "fetchSales"}, "policy": "continue"},
        {"name": "stock", "node": {"type": "function", "function": "fetchStock"}, "policy": "continue"},
        {"name": "widgets", "node": {"type": "merge", "element": "Widget"}, "policy": "continue"},
        {"name": "page", "node": {"type": "function", "function": "render"}, "policy": "stop"},
        {"name": "archive", "node": {"type": "function", "function": "archive"}, "policy": "continue"},
        {"name": "notify", "node": {"type": "function", "function": "notifyDone"}, "policy": "continue"}
      ],
      "connections": [
        {"source": "sales", "target": "widgets", "transform": "salesWidget"},
        {"source": "sales", "target": "archive", "transform": "sales"},
        {"source": "sales", "target": "notify", "transform": "discard"},
        {"source": "stock", "target": "widgets", "transform": "stockWidget"},
        {"source": "widgets", "target": "page", "transform": "widgets"}
      ]
    }
  ]
}
