{
  "main": "users",
  "functions": [
    {"id": "fetchAllUsers", "input": "Tenant", "output": {"stream": "User"}},
    {"id": "fetchProfile", "input": "UserId", "output": {"single": "RawProfile"}},
    {"id": "formatProfile", "input": "RawProfile", "output": {"single": "Profile"}},
    {"id": "fetchOrders", "input": "UserId", "output": {"single": "Orders"}}
  ],
  "transforms": [
    {"id": "user", "input": "User", "output": "User"},
    {"id": "userId", "input": "User", "output": "UserId"},
    {"id": "rawProfile", "input": "RawProfile", "output": "RawProfile"},
    {"id": "profileSummary", "input": "Profile", "output": "Summary"},
    {"id": "ordersSummary", "input": "Orders", "output": "Summary"},
    {"id": "summaries", "input": {"list": "Summary"}, "output": {"list": "Summary"}}
  ],
  "workflows": [
    {
      "id": "users",
      "input": {"type": "Tenant", "placement": "fetchAllUsers"},
      "placements": [
        {"name": "fetchAllUsers", "node": {"type": "function", "function": "fetchAllUsers"}, "policy": "stop"},
        {
          "name": "perUser",
          "node": {
            "type": "concurrency",
            "input": "User",
            "limit": 2,
            "output": "list",
            "element": "Summary",
            "tasks": [
              {
                "name": "profile",
                "body": {"type": "subworkflow", "workflow": "profileFlow", "output": "format"},
                "inputTransform": "userId",
                "outputTransform": "profileSummary",
                "policy": "continue"
              },
              {
                "name": "orders",
                "body": {"type": "function", "function": "fetchOrders"},
                "inputTransform": "userId",
                "outputTransform": "ordersSummary",
                "policy": "continue",
                "timeout": {"callMs": 5000}
              }
            ]
          },
          "policy": "continue"
        },
        {"name": "all", "node": {"type": "waitStream", "element": {"list": "Summary"}}, "policy": "stop"}
      ],
      "connections": [
        {"source": "fetchAllUsers", "target": "perUser", "transform": "user"},
        {"source": "perUser", "target": "all", "transform": "summaries"}
      ]
    },
    {
      "id": "profileFlow",
      "input": {"type": "UserId", "placement": "fetch"},
      "placements": [
        {"name": "fetch", "node": {"type": "function", "function": "fetchProfile"}, "policy": "continue"},
        {"name": "format", "node": {"type": "function", "function": "formatProfile"}, "policy": "continue"}
      ],
      "connections": [
        {"source": "fetch", "target": "format", "transform": "rawProfile"}
      ]
    }
  ]
}
